{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Vault",
  "version": "0.1.15",
  "identifier": "com.vault.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vault",
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Communication",
    "shortDescription": "E2E Encrypted Messenger",
    "longDescription": "Vault (Vault) is an end-to-end encrypted messenger with support for individual and group chats, file sharing, and email integration."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}