{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Sfera",
  "version": "0.1.0",
  "identifier": "com.vault.sfera",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sfera",
        "width": 960,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Sfera — social network for your own circle",
    "longDescription": "Vault Sfera: feed, spheres and media on the same keys and transport as the messenger. Media stays in storage the user chose."
  }
}
