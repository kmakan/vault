# Whisper (MailCipher) - Environment Configuration

# Database
DB_PASSWORD=whisper_dev_password
DB_PORT=5432
DATABASE_URL=postgresql://whisper:whisper_dev_password@localhost:5432/whisper

# Backend
HOST=0.0.0.0
PORT=8080

# JWT (REQUIRED - generate a strong secret: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Email (optional, for testing)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993