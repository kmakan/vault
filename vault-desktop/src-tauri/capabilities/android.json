{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "android",
  "description": "Android-only capabilities (QR scanner + opener for update button + relay http)",
  "windows": [
    "main"
  ],
  "platforms": [
    "android"
  ],
  "permissions": [
    "barcode-scanner:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/" },
        { "url": "https://*/*" }
      ]
    }
  ]
}
