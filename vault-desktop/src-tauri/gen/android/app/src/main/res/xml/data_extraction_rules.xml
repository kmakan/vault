<?xml version="1.0" encoding="utf-8"?>
<!-- Security (03.09, аудит перед релизом): запрещаем облачный бэкап ВСЕХ
     данных Vault (Android Auto Backup / cloud[релеит]/device-transfer).
     В приватных данных приложения лежат: sqlite (история чатов, kv),
     groups.json (ключи групп), ~/.vault (ключи, device.key, credentials.enc).
     allowBackup=false закрывает основной канал; dataExtractionRules
     дополнительно запрещают transfer на Android 12+ (D2D-миграция). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
