[Unit]
Description=Vault: проверка доступности сайтов (уведомление при изменении)

[Timer]
# 4 раза в сутки: сервер стабилен, чаще — лишний шум. При аварии сторож
# всё равно заметит переход (за ≤6 часов) и сам поставит на расписание
# сторож подъёма.
OnCalendar=*-*-* 00,06,12,18:00:00
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
